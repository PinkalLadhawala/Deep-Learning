  "scoring_methodology": {
    "frequency_score": {
      "description": "Measures how often a theme appears across all reviews",
      "scale": "1-100",
      "calculation": "(Number of reviews mentioning theme / Total reviews) * 100",
      "thresholds": {
        "very_common": "80-100",
        "common": "60-79",
        "moderate": "40-59",
        "occasional": "20-39",
        "rare": "1-19"
      }
    },
    "severity_score": {
      "description": "Measures the impact of the theme on customer experience based on sentiment and context",
      "scale": "1-10",
      "factors": [
        "Sentiment intensity (very negative vs. mildly negative)",
        "Impact on safety",
        "Effect on overall satisfaction",
        "Likelihood to prevent return visits",
        "Mention in conjunction with other issues"
      ],
      "thresholds": {
        "critical": "8-10",
        "high": "6-7.9",
        "medium": "4-5.9",
        "low": "1-3.9"
      }
    },
    "composite_ranking": {
      "description": "Combines frequency and severity to determine overall ranking",
      "formula": "(Frequency * 0.5) + (Severity * 10 * 0.5)",
      "rationale": "Balances how common an issue is with how severely it impacts the customer experience"
    }
  },
  
  "error_handling": {
    "no_reviews_found": {
      "message": "Unable to find sufficient reviews for the selected parks",
      "action": "Select different parks or adjust search criteria"
    },
    "api_failure": {
      "message": "AI analysis service unavailable",
      "action": "Retry after a brief delay or use fallback analysis method"
    },
    "invalid_response": {
      "message": "AI response could not be parsed",
      "action": "Retry with clearer prompt or validate response structure"
    },
    "rate_limit": {
      "message": "Too many requests. Please wait.",
      "action": "Implement exponential backoff and retry"
    }
  },
  
