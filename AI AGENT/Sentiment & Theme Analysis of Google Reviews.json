      },
      "themes": [
        {
          "rank": "integer (1-10)",
          "name": "string",
          "frequency": "integer (1-100)",
          "severity": "float (1-10)",
          "explanation": "string (1-3 sentences)",
          "percentage": "integer (% of reviews mentioning)",
          "exampleComplaints": "array of strings",
          "impact_category": "string (Critical/High/Medium/Low)"
        }
      ],
      "recommendations": {
        "immediate_action_required": "array of theme names",
        "monitor_closely": "array of theme names",
        "industry_benchmarks": "object with comparison data"
      }
    }
