  "workflow_steps": [
    {
      "step": 1,
      "name": "Initialize Analysis",
      "description": "Set up the analysis environment and prepare data collection",
      "actions": [
        "Load trampoline park database",
        "Initialize AI model connection",
        "Set analysis parameters"
      ],
      "duration_estimate": "5 seconds",
      "status_message": "Initializing analysis..."
    },
    {
      "step": 2,
      "name": "Random Park Selection",
      "description": "Randomly select 15 parks from the database",
      "actions": [
        "Shuffle park database",
        "Select first 15 parks from shuffled list",
        "Store selected parks for analysis"
      ],
      "duration_estimate": "1 second",
      "status_message": "Selecting 15 random parks...",
      "output_format": "Array of park objects with id, name, and location"
    },
    {
      "step": 3,
      "name": "Review Data Collection",
      "description": "Collect customer reviews from each selected park",
      "actions": [
        "Iterate through selected parks",
        "Fetch reviews from review platforms (Google, Yelp, Facebook)",
        "Aggregate reviews per park",
        "Track progress for user feedback"
      ],
      "duration_estimate": "30-60 seconds",
      "status_message": "Fetching reviews from {park_name} ({current}/{total})...",
      "review_sources": [
        "Google Reviews",
        "Yelp",
        "Facebook Reviews",
        "TripAdvisor",
        "Direct customer feedback"
      ],
      "filters": {
        "rating_range": "1-3 stars",
        "time_period": "Last 12 months",
        "min_review_length": "20 characters",
        "language": "English"
      }
    },
    {
      "step": 4,
      "name": "Review Aggregation",
      "description": "Compile all reviews and prepare for AI analysis",
      "actions": [
        "Calculate total review count",
        "Organize reviews by park",
        "Extract review text and metadata",
        "Prepare batch for AI processing"
      ],
      "duration_estimate": "5 seconds",
      "status_message": "Collected {total_reviews} reviews. Preparing for AI analysis...",
      "output_format": {
        "total_reviews": "integer",
        "reviews_per_park": "array of objects",
        "time_range": "date range"
      }
    },
    {
      "step": 5,
      "name": "AI Analysis",
      "description": "Use Claude AI to analyze reviews and identify negative themes",
      "actions": [
        "Send reviews to Claude API",
        "Request theme identification",
        "Request frequency and severity scoring",
        "Parse AI response"
      ],
      "duration_estimate": "10-20 seconds",
      "status_message": "AI analyzing review patterns and themes...",
      "ai_prompt_template": {
        "role": "You are analyzing customer reviews for {num_parks} trampoline parks in the USA",
        "task": "Identify and rank the top 10 NEGATIVE themes affecting customer experience",
        "requirements": [
          "Theme name",
          "Frequency score (1-100)",
          "Severity score (1-10)",
          "Brief explanation (1-3 sentences)",
          "Estimated percentage of reviews",
          "Example complaints"
        ],
        "themes_to_consider": [
          "cleanliness",
          "safety concerns",
          "staff attitude/professionalism",
          "overcrowding",
          "long wait times",
          "pricing/value",
          "food quality",
          "birthday party management",
          "equipment maintenance",
          "facility temperature",
          "waiver process",
          "sock requirements",
          "parking issues",
          "noise levels",
          "age restrictions",
          "time limits",
          "arcade games",
          "lockers/storage"
        ],
        "output_format": "JSON only, no markdown"
      }
    },
    {
      "step": 6,
      "name": "Results Processing",
      "description": "Process AI response and structure the results",
      "actions": [
        "Parse JSON response from AI",
        "Validate theme data structure",
        "Calculate composite scores",
        "Sort themes by ranking"
      ],
      "duration_estimate": "2 seconds",
      "status_message": "Processing analysis results...",
      "validation_rules": {
        "required_fields": ["rank", "name", "frequency", "severity", "explanation", "percentage"],
        "frequency_range": "1-100",
        "severity_range": "1-10",
        "theme_count": 10
      }
    },
    {
      "step": 7,
      "name": "Results Presentation",
      "description": "Display results to user in an organized format",
      "actions": [
        "Render summary statistics",
        "Display selected parks",
        "Show ranked themes with visualizations",
        "Provide downloadable report"
      ],
      "duration_estimate": "Instant",
      "status_message": "Analysis complete!",
      "display_components": [
        "Summary stats cards",
        "Selected parks list",
        "Theme ranking cards",
        "Frequency and severity charts",
        "Example complaints",
        "Methodology note"
      ]
    }
  ],
  
  "output_schema": {
