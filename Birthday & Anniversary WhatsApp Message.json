    {
      "parameters": {
        "jsCode": "// Determine if this is a birthday or anniversary\nconst eventType = $input.first().json.Event \n  //=== 'Birthday' ? 'Birthday' : 'Anniversary';\n\n// Format the message\nconst name = $input.first().json.Name;\nconst message = eventType === 'Birthday' \n  ? `🎉 Happy Birthday ${name}! 🎂 Wishing you a wonderful day filled with joy and happiness!`\n  : `💐 Happy Anniversary ${name}! 💑 Wishing you many more years of love and happiness together!`;\n\n// Format phone number (ensure it has country code)\nlet phone = $input.item.json['Phone #'].toString().replace(/\\D/g, '');\n\n// Handle Indian phone numbers (10 digits starting with 6-9)\nif (phone.length === 10 && /^[6-9]/.test(phone)) {\n  phone = '91' + phone; // Add India country code\n}\n// Handle US phone numbers (10 digits starting with 2-9)\nelse if (phone.length === 10) {\n  phone = '1' + phone; // Add US country code\n}\n// If already has country code, use as is\n\nreturn {\n  phone: `whatsapp:+${phone}`,\n  message: message,\n  name: name,\n  eventType: eventType\n};"
      },
      "id": "9e67704c-22e8-49b7-8182-01aa7bbe0483",
